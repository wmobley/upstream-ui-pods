# Tapis tenant for this deployment
VITE_TAPIS_BASE_URL=https://portals.tapis.io
VITE_TAPIS_PODS_BASE_URL=https://portals.tapis.io

# OAuth2 client registered on the portals tenant
VITE_TAPIS_OAUTH_CLIENT_ID=upstream-develop-local

# CKAN (optional)
VITE_CKAN_URL=https://ckan.tacc.utexas.edu

# VITE_UPSTREAM_API_URL is intentionally unset here so instance discovery
# is enabled by default. Set it in .env.local to pin to a specific API
# (e.g. http://localhost:8000 when running the API locally).

# Base Upstream API URL for PT2050-DataX allocation holders.
# Only used when instance discovery is enabled (VITE_UPSTREAM_API_URL unset).
# Defaults to https://upstreamapi.pods.portals.tapis.io if not set.
# VITE_BASE_UPSTREAM_API_URL=https://upstreamapi.pods.portals.tapis.io
